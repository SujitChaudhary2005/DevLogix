@model DevLogix.ViewModels.Projects.ProjectDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.Title</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">Edit</a>
        <a asp-controller="Tickets" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-primary btn-sm">
            New Ticket
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Description))
{
    <p class="lead text-muted">@Model.Description</p>
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center border-primary">
            <div class="card-body">
                <h3 class="card-title">@Model.Metrics.Total</h3>
                <p class="card-text text-muted">Total Tickets</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-warning">
            <div class="card-body">
                <h3 class="card-title text-warning">@Model.Metrics.Open</h3>
                <p class="card-text text-muted">Open</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-success">
            <div class="card-body">
                <h3 class="card-title text-success">@Model.Metrics.Resolved</h3>
                <p class="card-text text-muted">Resolved</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-secondary">
            <div class="card-body">
                <h3 class="card-title text-secondary">@Model.Metrics.Closed</h3>
                <p class="card-text text-muted">Closed</p>
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-4" id="projectTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tickets-tab" data-bs-toggle="tab" data-bs-target="#tickets" type="button" role="tab">
            Tickets (@Model.RecentTickets.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="members-tab" data-bs-toggle="tab" data-bs-target="#members" type="button" role="tab">
            Members (@Model.Members.Count)
        </button>
    </li>
</ul>

<div class="tab-content" id="projectTabContent">
    <!-- Tickets Tab -->
    <div class="tab-pane fade show active" id="tickets" role="tabpanel">
        @if (Model.RecentTickets.Count == 0)
        {
            <div class="text-center py-4">
                <p class="text-muted">No tickets yet.</p>
                <a asp-controller="Tickets" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-outline-primary">
                    Create First Ticket
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Assigned To</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.RecentTickets)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">
                                        @ticket.Title
                                    </a>
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(ticket.Status)">@ticket.Status</span>
                                </td>
                                <td>
                                    <span class="badge @GetPriorityBadgeClass(ticket.Priority)">@ticket.Priority</span>
                                </td>
                                <td>@(ticket.AssignedToName ?? "Unassigned")</td>
                                <td>@ticket.CreatedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <a asp-controller="Tickets" asp-action="Index" asp-route-projectId="@Model.Id" class="btn btn-outline-primary btn-sm">
                View All Tickets
            </a>
        }
    </div>

    <!-- Members Tab -->
    <div class="tab-pane fade" id="members" role="tabpanel">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Joined</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model.Members)
                    {
                        <tr>
                            <td>@member.FullName</td>
                            <td>@member.Email</td>
                            <td>@member.JoinedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <form asp-action="RemoveMember" asp-route-projectId="@Model.Id" asp-route-userId="@member.UserId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('Remove this member?')">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Projects</a>
</div>

@functions {
    string GetStatusBadgeClass(DevLogix.Models.TicketStatus status) => status switch
    {
        DevLogix.Models.TicketStatus.Todo => "bg-secondary",
        DevLogix.Models.TicketStatus.InProgress => "bg-primary",
        DevLogix.Models.TicketStatus.Resolved => "bg-success",
        DevLogix.Models.TicketStatus.Closed => "bg-dark",
        DevLogix.Models.TicketStatus.Reopened => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    string GetPriorityBadgeClass(DevLogix.Models.Priority priority) => priority switch
    {
        DevLogix.Models.Priority.Low => "bg-info text-dark",
        DevLogix.Models.Priority.Medium => "bg-warning text-dark",
        DevLogix.Models.Priority.High => "bg-danger",
        DevLogix.Models.Priority.Critical => "bg-danger",
        _ => "bg-secondary"
    };
}
