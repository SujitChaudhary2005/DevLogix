@model DevLogix.ViewModels.Tickets.TicketListViewModel
@{
    ViewData["Title"] = $"Tickets — {Model.ProjectTitle}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Tickets</h1>
        <p class="text-muted mb-0">
            Project: <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">@Model.ProjectTitle</a>
        </p>
    </div>
    <a asp-action="Create" asp-route-projectId="@Model.ProjectId" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Ticket
    </a>
</div>

<!-- Filters -->
<form method="get" class="card card-body bg-light mb-4">
    <input type="hidden" name="projectId" value="@Model.ProjectId" />
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                @foreach (var status in Enum.GetValues<DevLogix.Models.TicketStatus>())
                {
                    <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Priority</label>
            <select name="priority" class="form-select">
                <option value="">All Priorities</option>
                @foreach (var priority in Enum.GetValues<DevLogix.Models.Priority>())
                {
                    <option value="@priority" selected="@(Model.PriorityFilter == priority)">@priority</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Assignee</label>
            <input type="text" name="assignee" value="@Model.AssigneeFilter" class="form-control" placeholder="Filter by name..." />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
        </div>
    </div>
</form>

@if (Model.Tickets.Count == 0)
{
    <div class="text-center py-5">
        <h3 class="text-muted">No tickets found</h3>
        <p class="text-muted">Try adjusting your filters or create a new ticket.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Created By</th>
                    <th>Assigned To</th>
                    <th>Comments</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in Model.Tickets)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@ticket.Id" class="text-decoration-none fw-semibold">
                                @ticket.Title
                            </a>
                        </td>
                        <td><span class="badge @GetStatusBadgeClass(ticket.Status)">@ticket.Status</span></td>
                        <td><span class="badge @GetPriorityBadgeClass(ticket.Priority)">@ticket.Priority</span></td>
                        <td>@ticket.CreatedByName</td>
                        <td>@(ticket.AssignedToName ?? "<span class='text-muted'>Unassigned</span>")</td>
                        <td><span class="badge bg-light text-dark">@ticket.CommentCount</span></td>
                        <td>@ticket.CreatedAt.ToString("MMM dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-projectId="@Model.ProjectId"
                       asp-route-page="@(Model.CurrentPage - 1)" asp-route-status="@Model.StatusFilter"
                       asp-route-priority="@Model.PriorityFilter" asp-route-assignee="@Model.AssigneeFilter">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-projectId="@Model.ProjectId"
                           asp-route-page="@i" asp-route-status="@Model.StatusFilter"
                           asp-route-priority="@Model.PriorityFilter" asp-route-assignee="@Model.AssigneeFilter">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-projectId="@Model.ProjectId"
                       asp-route-page="@(Model.CurrentPage + 1)" asp-route-status="@Model.StatusFilter"
                       asp-route-priority="@Model.PriorityFilter" asp-route-assignee="@Model.AssigneeFilter">Next</a>
                </li>
            </ul>
        </nav>
    }
}

@functions {
    string GetStatusBadgeClass(DevLogix.Models.TicketStatus status) => status switch
    {
        DevLogix.Models.TicketStatus.Todo => "bg-secondary",
        DevLogix.Models.TicketStatus.InProgress => "bg-primary",
        DevLogix.Models.TicketStatus.Resolved => "bg-success",
        DevLogix.Models.TicketStatus.Closed => "bg-dark",
        DevLogix.Models.TicketStatus.Reopened => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    string GetPriorityBadgeClass(DevLogix.Models.Priority priority) => priority switch
    {
        DevLogix.Models.Priority.Low => "bg-info text-dark",
        DevLogix.Models.Priority.Medium => "bg-warning text-dark",
        DevLogix.Models.Priority.High => "bg-danger",
        DevLogix.Models.Priority.Critical => "bg-danger",
        _ => "bg-secondary"
    };
}
