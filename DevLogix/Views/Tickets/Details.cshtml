@model DevLogix.ViewModels.Tickets.TicketDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="row">
    <!-- Main Content -->
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h1 class="mb-1">@Model.Title</h1>
                <p class="text-muted">
                    In <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">@Model.ProjectTitle</a>
                    · Created by @Model.CreatedByName on @Model.CreatedAt.ToString("MMM dd, yyyy")
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">Delete</a>
            </div>
        </div>

        <!-- Description -->
        <div class="card mb-4">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="mb-0">@Model.Description</p>
                }
                else
                {
                    <p class="text-muted mb-0">No description provided.</p>
                }
            </div>
        </div>

        <!-- Comments Section -->
        <h4 class="mb-3">Comments (@Model.Comments.Count)</h4>

        @if (Model.Comments.Count == 0)
        {
            <p class="text-muted">No comments yet. Be the first to comment.</p>
        }
        else
        {
            @foreach (var comment in Model.Comments)
            {
                <div class="card mb-2">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between">
                            <small class="fw-semibold">@comment.UserName</small>
                            <small class="text-muted">@comment.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</small>
                        </div>
                        <p class="mb-1 mt-1">@comment.Content</p>
                        @if (comment.CanDelete)
                        {
                            <form asp-controller="Comments" asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@comment.Id" />
                                <input type="hidden" name="ticketId" value="@Model.Id" />
                                <button type="submit" class="btn btn-link btn-sm text-danger p-0"
                                        onclick="return confirm('Delete this comment?')">Delete</button>
                            </form>
                        }
                    </div>
                </div>
            }
        }

        <!-- Add Comment Form -->
        <div class="card mt-3 mb-4">
            <div class="card-body">
                <form asp-controller="Comments" asp-action="Create" method="post">
                    <input type="hidden" name="ticketId" value="@Model.Id" />
                    <div class="mb-2">
                        <textarea name="content" class="form-control" rows="3" placeholder="Write a comment..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Add Comment</button>
                </form>
            </div>
        </div>

        <!-- Time Logs Section -->
        <h4 class="mb-3">Time Logs (@Model.TimeLogs.Count)</h4>

        @if (Model.TimeLogs.Count > 0)
        {
            <div class="table-responsive mb-3">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Minutes</th>
                            <th>Note</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.TimeLogs)
                        {
                            <tr>
                                <td>@log.UserName</td>
                                <td>@log.MinutesSpent min</td>
                                <td>@(log.Note ?? "—")</td>
                                <td>@log.LoggedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td>Total</td>
                            <td>@Model.TimeLogs.Sum(t => t.MinutesSpent) min</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }

        <!-- Log Time Form -->
        <div class="card mb-4">
            <div class="card-body">
                <form asp-controller="TimeLogs" asp-action="Create" method="post">
                    <input type="hidden" name="ticketId" value="@Model.Id" />
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Minutes</label>
                            <input type="number" name="minutes" class="form-control" min="1" required placeholder="30" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Note (optional)</label>
                            <input type="text" name="note" class="form-control" placeholder="What did you work on?" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-outline-primary w-100">Log Time</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">Details</div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt>Status</dt>
                    <dd>
                        <span class="badge @GetStatusBadgeClass(Model.Status) fs-6">@Model.Status</span>
                    </dd>

                    <dt>Priority</dt>
                    <dd>
                        <span class="badge @GetPriorityBadgeClass(Model.Priority) fs-6">@Model.Priority</span>
                    </dd>

                    <dt>Assigned To</dt>
                    <dd>@(Model.AssignedToName ?? "Unassigned")</dd>

                    <dt>Created</dt>
                    <dd>@Model.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</dd>
                </dl>
            </div>
        </div>

        <!-- Quick Status Change -->
        <div class="card mb-3">
            <div class="card-header">Update Status</div>
            <div class="card-body">
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <select name="newStatus" class="form-select mb-2" id="statusSelect">
                        @foreach (var status in Enum.GetValues<DevLogix.Models.TicketStatus>())
                        {
                            <option value="@status" selected="@(Model.Status == status)">@status</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm w-100">Update Status</button>
                </form>
            </div>
        </div>

        <!-- Attachments -->
        <div class="card mb-3">
            <div class="card-header">Attachments (@Model.Attachments.Count)</div>
            <div class="card-body">
                @if (Model.Attachments.Count == 0)
                {
                    <p class="text-muted mb-0">No attachments.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var attachment in Model.Attachments)
                        {
                            <li class="mb-2">
                                <a asp-controller="Attachments" asp-action="Download" asp-route-id="@attachment.Id">
                                    @attachment.FileName
                                </a>
                                <br />
                                <small class="text-muted">
                                    @(attachment.FileSizeBytes / 1024) KB · @attachment.UploadedByName
                                </small>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-secondary">Back to Tickets</a>
</div>

@functions {
    string GetStatusBadgeClass(DevLogix.Models.TicketStatus status) => status switch
    {
        DevLogix.Models.TicketStatus.Todo => "bg-secondary",
        DevLogix.Models.TicketStatus.InProgress => "bg-primary",
        DevLogix.Models.TicketStatus.Resolved => "bg-success",
        DevLogix.Models.TicketStatus.Closed => "bg-dark",
        DevLogix.Models.TicketStatus.Reopened => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    string GetPriorityBadgeClass(DevLogix.Models.Priority priority) => priority switch
    {
        DevLogix.Models.Priority.Low => "bg-info text-dark",
        DevLogix.Models.Priority.Medium => "bg-warning text-dark",
        DevLogix.Models.Priority.High => "bg-danger",
        DevLogix.Models.Priority.Critical => "bg-danger",
        _ => "bg-secondary"
    };
}
