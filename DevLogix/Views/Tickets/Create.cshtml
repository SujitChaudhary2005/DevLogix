@model DevLogix.ViewModels.Tickets.TicketCreateViewModel
@{
    ViewData["Title"] = "Create Ticket";
}

<h1>Create Ticket</h1>
<hr />

<div class="row">
    <div class="col-md-8 col-lg-6">
        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="ProjectId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="Brief summary of the issue" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="6" placeholder="Detailed description..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Priority" class="form-label"></label>
                    <select asp-for="Priority" asp-items="Html.GetEnumSelectList<DevLogix.Models.Priority>()" class="form-select">
                    </select>
                    <span asp-validation-for="Priority" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AssignedToId" class="form-label"></label>
                    <select asp-for="AssignedToId" asp-items="Model.ProjectMembers" class="form-select">
                        <option value="">-- Unassigned --</option>
                    </select>
                    <span asp-validation-for="AssignedToId" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Ticket</button>
                <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
