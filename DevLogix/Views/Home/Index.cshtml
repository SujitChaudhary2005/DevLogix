@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">DevLogix</h1>
    <p class="lead text-muted">Project Management &amp; Bug Tracking — Simplified</p>
    <hr class="my-4" />

    @if (User.Identity?.IsAuthenticated == true)
    {
        <p>Welcome back! Manage your projects and track issues.</p>
        <div class="d-flex gap-3 justify-content-center">
            <a asp-controller="Projects" asp-action="Index" class="btn btn-primary btn-lg">
                My Projects
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary btn-lg">
                Dashboard
            </a>
        </div>
    }
    else
    {
        <p>A self-hosted, lightweight alternative for managing projects and tracking bugs.</p>
        <div class="d-flex gap-3 justify-content-center">
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">
                Get Started
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg">
                Sign In
            </a>
        </div>
    }
</div>

<div class="row text-center mt-5">
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Project Management</h5>
                <p class="card-text text-muted">Create and manage projects with team members, track progress, and stay organized.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Issue Tracking</h5>
                <p class="card-text text-muted">Create tickets, assign priorities, track status changes, and collaborate with comments.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Time Logging</h5>
                <p class="card-text text-muted">Log time spent on tickets, export data, and get insights from the dashboard.</p>
            </div>
        </div>
    </div>
</div>
