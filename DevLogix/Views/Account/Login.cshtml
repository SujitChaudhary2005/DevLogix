@model DevLogix.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Login";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center mt-5 mb-5 animate-fade-in-up">
    <div class="col-md-5">
        <div class="card shadow-lg border-0" style="border-radius: 1.5rem; overflow: hidden;">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-box-arrow-in-right fs-3"></i>
                    </div>
                    <h3 class="fw-bold text-gradient">Welcome back</h3>
                    <p class="text-muted">Enter your credentials to access your workspace.</p>
                </div>

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" id="floatingEmail" placeholder="name@example.com" />
                        <label asp-for="Email" for="floatingEmail">Email address</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" id="floatingPassword" placeholder="Password" />
                        <label asp-for="Password" for="floatingPassword">Password</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                            <label asp-for="RememberMe" class="form-check-label text-muted" for="rememberMeCheck">Remember me</label>
                        </div>
                        <a href="#" class="text-primary text-decoration-none small fw-semibold">Forgot password?</a>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm fw-bold">Sign In</button>
                    </div>
                    
                    <div class="position-relative mt-4 mb-4 text-center">
                        <hr class="text-muted opacity-25">
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">or continue with</span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <button type="button" class="btn btn-outline-secondary rounded-pill w-100 bg-light border-0 fw-semibold">
                            <i class="bi bi-google text-danger me-2"></i> Google
                        </button>
                        <button type="button" class="btn btn-outline-secondary rounded-pill w-100 bg-light border-0 fw-semibold">
                            <i class="bi bi-github text-dark me-2"></i> GitHub
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light border-0 py-3 text-center">
                <p class="mb-0 text-muted">Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-primary text-decoration-none fw-bold">Create one</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
