@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5 mb-5 animate-fade-in-up">
    <div class="col-md-6 text-center">
        <div class="card shadow-lg border-0" style="border-radius: 1.5rem; overflow: hidden;">
            <div class="card-body p-5">
                <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle mb-4" style="width: 80px; height: 80px;">
                    <i class="bi bi-shield-lock fs-1"></i>
                </div>
                <h2 class="fw-bold text-danger mb-3">Access Denied</h2>
                <p class="text-muted fs-5 mb-4">You do not have permission to view this resource.</p>
                
                <div class="bg-light rounded-3 p-4 mb-4 text-start">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-info-circle text-muted fs-4"></i>
                        <span class="text-muted small">If you believe this is a mistake, please contact your workspace administrator to request access.</span>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-center mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                        Return Home
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 bg-white shadow-sm fw-semibold">
                        Go Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
